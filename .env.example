# ---------------------------------------------------------------------------
# Velnorix environment
#
# Copy to `.env` (`cp .env.example .env`). Every value here is safe for local
# development; production values come from your secret manager, never from Git.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# The role the APPLICATION connects with. It must never be a superuser and must
# never own tables: Row-Level Security depends on it (see docs/adr/0003).
DATABASE_URL=postgres://velnorix:velnorix@127.0.0.1:5433/velnorix
# The schema owner, used by migrations only.
DATABASE_MIGRATION_URL=postgres://postgres:postgres@127.0.0.1:5433/velnorix
DATABASE_POOL_MAX=10

# --- Local database (scripts/pg.mjs) ---------------------------------------
# Used when Docker is unavailable. Deployments use docker-compose.yml or a
# managed PostgreSQL instead.
PGPORT=5433
PGDATABASE=velnorix
PGDATA_DIR=.pgdata

# --- Hosts ------------------------------------------------------------------
APP_BASE_DOMAIN=velnorix.test
ADMIN_BASE_DOMAIN=admin.velnorix.test
# Allows ?__tenant=<slug> so a store can be opened without a wildcard domain
# (local dev and preview deployments). Ignored in production.
ALLOW_DEV_TENANT_OVERRIDE=true
ALLOWED_DEV_ORIGINS=*.e2b.app,*.e2b.dev

# --- Security ---------------------------------------------------------------
# 32 bytes, base64 or hex. Encrypts TOTP seeds at rest. ROTATE FOR PRODUCTION.
TOTP_ENCRYPTION_KEY=dmVsbm9yaXgtZGV2LXRvdHAta2V5LTMyLWJ5dGVzISE=
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=43200
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
TOTP_ISSUER=Velnorix

# --- Observability ----------------------------------------------------------
LOG_LEVEL=info
# Errors are only shipped to Sentry when a DSN is present.
# SENTRY_DSN=

# --- Seed (demo data) -------------------------------------------------------
SEED_PASSWORD="Sahara!Dune#2026"
SEED_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# --- Apps -------------------------------------------------------------------
# The admin console and the storefront are two separate Next.js apps, so they
# need two ports. `pnpm dev` runs both.
PORT=3000
STOREFRONT_PORT=3001
NODE_ENV=development
